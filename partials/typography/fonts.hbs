{{!-- Ubuntu Sans and Ubuntu Sans Mono (Google Fonts, SIL OFL), served by the theme --}}
<link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/ubuntu-sans-roman.woff2"}}" crossorigin="anonymous">
<link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/ubuntu-sans-mono-roman.woff2"}}" crossorigin="anonymous">
<style>
    @font-face {
        font-family: "Ubuntu Sans";
        font-style: normal;
        font-weight: 100 800;
        font-display: swap;
        src: url({{asset "fonts/ubuntu-sans-roman.woff2"}}) format("woff2");
    }

    @font-face {
        font-family: "Ubuntu Sans";
        font-style: italic;
        font-weight: 100 800;
        font-display: swap;
        src: url({{asset "fonts/ubuntu-sans-italic.woff2"}}) format("woff2");
    }

    @font-face {
        font-family: "Ubuntu Sans Mono";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url({{asset "fonts/ubuntu-sans-mono-roman.woff2"}}) format("woff2");
    }

    @font-face {
        font-family: "Ubuntu Sans Mono";
        font-style: italic;
        font-weight: 400 700;
        font-display: swap;
        src: url({{asset "fonts/ubuntu-sans-mono-italic.woff2"}}) format("woff2");
    }
</style>
